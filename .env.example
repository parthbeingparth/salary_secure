# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-only — never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form email delivery (Resend)
# Get a key at https://resend.com — without this, contact messages are logged server-side only
RESEND_API_KEY=
# Verified sender, e.g. "Salary Secure <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Optional: durable rate limiting across Vercel instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional analytics (wire in lib/analytics.ts)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
